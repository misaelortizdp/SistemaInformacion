<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CashFlowSystem.MAUI.ViewModels"
             xmlns:models="clr-namespace:CashFlowSystem.MAUI.Models"
             x:Class="CashFlowSystem.MAUI.Views.CategoriesPage"
             x:DataType="viewmodels:CategoriesViewModel"
             Title="Categorías">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Header with Filter -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" Spacing="10" BackgroundColor="{StaticResource Gray100}">
            <Label Text="Gestión de Categorías"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="Tipo:" VerticalOptions="Center" TextColor="{StaticResource Gray700}" />
                <Picker ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding FilterType}"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="White" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Categories List -->
        <RefreshView Grid.Row="1" Command="{Binding LoadCategoriesCommand}"  IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Categories}"
                           Margin="20,10">
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Label Text="📂" FontSize="60" HorizontalOptions="Center" />
                            <Label Text="No hay categorías"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray600}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                             BackgroundColor="#F44336"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DeleteCategoryCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}"
                                    Padding="15"
                                    Margin="0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=EditCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            BackgroundColor="{Binding Color}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="25" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Icon}"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Gray900}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray600}" />
                                    </VerticalStackLayout>

                                    <!-- Type Badge -->
                                    <Border Grid.Column="2"
                                            Padding="10,5"
                                            VerticalOptions="Center"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="Type">
                                                <Binding.Converter>
                                                    <StaticResource ResourceKey="TransactionTypeToColorConverter" />
                                                </Binding.Converter>
                                            </Binding>
                                        </Border.BackgroundColor>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Type}"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Text="+ Nueva Categoría"
                Command="{Binding AddCategoryCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Margin="20"
                HeightRequest="55"
                CornerRadius="15"
                FontSize="16"
                FontAttributes="Bold" />
    </Grid>
</ContentPage>
