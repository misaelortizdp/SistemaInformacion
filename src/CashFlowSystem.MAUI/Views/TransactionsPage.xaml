<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CashFlowSystem.MAUI.ViewModels"
             xmlns:models="clr-namespace:CashFlowSystem.MAUI.Models"
             x:Class="CashFlowSystem.MAUI.Views.TransactionsPage"
             x:DataType="viewmodels:TransactionsViewModel"
             Title="Transacciones">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Filter and Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" Spacing="10" BackgroundColor="{StaticResource Gray100}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Mis Transacciones"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Gray900}" />

                <Button Grid.Column="1" Text="🔍 Buscar"
                        Command="{Binding SearchTransactionsCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        HeightRequest="40"
                        WidthRequest="110"
                        CornerRadius="8"
                        FontSize="13" />
            </Grid>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Filtrar:" VerticalOptions="Center" TextColor="{StaticResource Gray700}" />
                <Picker ItemsSource="{Binding FilterOptions}"
                        SelectedItem="{Binding FilterType}"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="White"
                        TextColor="{StaticResource Gray900}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Transactions List -->
        <RefreshView Grid.Row="1"
                     Command="{Binding LoadTransactionsCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Transactions}"
                           Margin="20,10">
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Spacing="10">
                            <Label Text="📋" FontSize="60" HorizontalOptions="Center" />
                            <Label Text="No hay transacciones"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray600}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionDto">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar"
                                             BackgroundColor="#2196F3"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                             BackgroundColor="#F44336"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}"
                                    Padding="15"
                                    Margin="0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Grid.RowSpan="3"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            VerticalOptions="Center"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="25" />
                                        </Border.StrokeShape>
                                        <Border.BackgroundColor>
                                            <MultiBinding Converter="{StaticResource TransactionTypeToColorConverter}">
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Border.BackgroundColor>
                                        <Label Text="{Binding Type, Converter={StaticResource TransactionTypeToIconConverter}}"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="White" />
                                    </Border>

                                    <!-- Description -->
                                    <Label Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Description}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}" />

                                    <!-- Category -->
                                    <Label Grid.Column="1" Grid.Row="1"
                                           Text="{Binding CategoryName}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray600}" />

                                    <!-- Date -->
                                    <Label Grid.Column="1" Grid.Row="2"
                                           Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />

                                    <!-- Amount -->
                                    <Label Grid.Column="2" Grid.RowSpan="3"
                                           Text="{Binding Amount, StringFormat='${0:N2}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                                        <Label.TextColor>
                                            <MultiBinding Converter="{StaticResource TransactionTypeToColorConverter}">
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Text="+ Nueva Transacción"
                Command="{Binding AddTransactionCommand}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                Margin="20"
                HeightRequest="55"
                CornerRadius="15"
                FontSize="16"
                FontAttributes="Bold" />
    </Grid>
</ContentPage>
