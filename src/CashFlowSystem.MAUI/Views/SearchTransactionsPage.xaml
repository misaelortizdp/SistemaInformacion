<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CashFlowSystem.MAUI.ViewModels"
             xmlns:models="clr-namespace:CashFlowSystem.MAUI.Models"
             x:Class="CashFlowSystem.MAUI.Views.SearchTransactionsPage"
             x:DataType="viewmodels:SearchTransactionsViewModel"
             Title="Búsqueda Avanzada">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Filters Section -->
        <ScrollView Grid.Row="0" BackgroundColor="{StaticResource Gray100}" MaximumHeightRequest="400">
            <VerticalStackLayout Padding="20,10" Spacing="15">

                <Label Text="Filtros de Búsqueda"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <!-- Search Text -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Buscar texto" TextColor="{StaticResource Gray700}" FontSize="14" />
                    <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding SearchText}" Placeholder="Descripción, notas o referencia..." BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Date Range -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Fecha desde" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="8,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding StartDate}" BackgroundColor="Transparent" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Fecha hasta" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="8,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <DatePicker Date="{Binding EndDate}" BackgroundColor="Transparent" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Amount Range -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Monto mínimo" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding MinAmount}" Placeholder="0.00" Keyboard="Numeric" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Monto máximo" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray300}" Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry Text="{Binding MaxAmount}" Placeholder="0.00" Keyboard="Numeric" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Type -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Tipo" TextColor="{StaticResource Gray700}" FontSize="14" />
                    <Picker ItemsSource="{Binding TypeOptions}"
                            SelectedItem="{Binding Type}"
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <!-- Order By -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Ordenar por" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <Picker ItemsSource="{Binding OrderByOptions}"
                                SelectedItem="{Binding OrderBy}"
                                BackgroundColor="White" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="5">
                        <Label Text="Descendente" TextColor="{StaticResource Gray700}" FontSize="14" />
                        <CheckBox IsChecked="{Binding Descending}" Color="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Limpiar" Command="{Binding ClearFiltersCommand}"
                            BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                            HeightRequest="45" CornerRadius="10" />
                    <Button Grid.Column="1" Text="🔍 Buscar" Command="{Binding SearchCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            HeightRequest="45" CornerRadius="10" FontAttributes="Bold" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Results Section -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="0">

            <!-- Results Header -->
            <HorizontalStackLayout Grid.Row="0" Padding="20,10" BackgroundColor="{StaticResource Gray50}">
                <Label Text="Resultados: " FontSize="14" TextColor="{StaticResource Gray700}" />
                <Label Text="{Binding SearchResults.Count}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>

            <!-- Results List -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" Margin="20,10">
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Label Text="🔍" FontSize="60" HorizontalOptions="Center" />
                            <Label Text="Sin resultados"
                                   FontSize="16"
                                   TextColor="{StaticResource Gray600}"
                                   HorizontalOptions="Center" />
                            <Label Text="Ajusta los filtros y presiona Buscar"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionDto">
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar"
                                             BackgroundColor="#2196F3"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchTransactionsViewModel}}, Path=EditTransactionCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                             BackgroundColor="#F44336"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchTransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                             CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}"
                                    Padding="15"
                                    Margin="0,5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SearchTransactionsViewModel}}, Path=EditTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Grid.RowSpan="3"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            VerticalOptions="Center"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="25" />
                                        </Border.StrokeShape>
                                        <Border.BackgroundColor>
                                            <MultiBinding Converter="{StaticResource TransactionTypeToColorConverter}">
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Border.BackgroundColor>
                                        <Label Text="{Binding Type, Converter={StaticResource TransactionTypeToIconConverter}}"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="White" />
                                    </Border>

                                    <!-- Description -->
                                    <Label Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Description}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}" />

                                    <!-- Category -->
                                    <Label Grid.Column="1" Grid.Row="1"
                                           Text="{Binding CategoryName}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray600}" />

                                    <!-- Date -->
                                    <Label Grid.Column="1" Grid.Row="2"
                                           Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />

                                    <!-- Amount -->
                                    <Label Grid.Column="2" Grid.RowSpan="3"
                                           Text="{Binding Amount, StringFormat='${0:N2}'}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End">
                                        <Label.TextColor>
                                            <MultiBinding Converter="{StaticResource TransactionTypeToColorConverter}">
                                                <Binding Path="Type" />
                                            </MultiBinding>
                                        </Label.TextColor>
                                    </Label>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading Indicator -->
            <ActivityIndicator Grid.Row="1"
                             IsRunning="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"
                             Color="{StaticResource Primary}"
                             HeightRequest="50"
                             WidthRequest="50"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
