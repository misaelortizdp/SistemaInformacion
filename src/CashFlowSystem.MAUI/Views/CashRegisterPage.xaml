<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CashFlowSystem.MAUI.ViewModels"
             x:Class="CashFlowSystem.MAUI.Views.CashRegisterPage"
             x:DataType="viewmodels:CashRegisterViewModel"
             Title="Caja">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Gestión de Caja"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" />

            <!-- No Cash Register Open -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding HasCashRegister, Converter={StaticResource InvertedBoolConverter}}">

                <Border BackgroundColor="{StaticResource Gray100}"
                        StrokeThickness="0"
                        Padding="30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="🏦" FontSize="60" HorizontalOptions="Center" />
                        <Label Text="No hay caja abierta"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray900}" />
                        <Label Text="Abre una nueva caja para comenzar a registrar operaciones"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Open Cash Register Form -->
                <Border BackgroundColor="White"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray200}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Abrir Nueva Caja"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Balance Inicial *" TextColor="{StaticResource Gray700}" FontSize="14" />
                            <Border BackgroundColor="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray300}"
                                    Padding="12,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding OpeningBalance}"
                                       Placeholder="0.00"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Abrir Caja"
                                Command="{Binding OpenCashRegisterCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                HeightRequest="50"
                                CornerRadius="10"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Cash Register Open -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding HasCashRegister}">

                <!-- Status Card -->
                <Border BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="✅" FontSize="24" />
                            <Label Text="Caja Abierta"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <BoxView Color="White" Opacity="0.3" HeightRequest="1" Margin="0,10" />

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Fecha de apertura:"
                                   TextColor="White"
                                   FontSize="14"
                                   Opacity="0.9" />
                            <Label Text="{Binding OpeningDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                   TextColor="White"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Balance inicial:"
                                   TextColor="White"
                                   FontSize="14"
                                   Opacity="0.9" />
                            <Label Text="{Binding OpeningBalance, StringFormat='${0:N2}'}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Close Cash Register Form -->
                <Border BackgroundColor="White"
                        StrokeThickness="1"
                        Stroke="{StaticResource Gray200}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Cerrar Caja (Arqueo)"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                        <Label Text="Cuenta el efectivo y registra el balance de cierre para realizar el arqueo de caja"
                               FontSize="13"
                               TextColor="{StaticResource Gray600}"
                               LineBreakMode="WordWrap" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Balance de Cierre Real *" TextColor="{StaticResource Gray700}" FontSize="14" />
                            <Border BackgroundColor="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray300}"
                                    Padding="12,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Entry Text="{Binding ClosingBalance}"
                                       Placeholder="0.00"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Cerrar Caja"
                                Command="{Binding CloseCashRegisterCommand}"
                                BackgroundColor="#F44336"
                                TextColor="White"
                                HeightRequest="50"
                                CornerRadius="10"
                                FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"
                             Color="{StaticResource Primary}"
                             HeightRequest="40" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
